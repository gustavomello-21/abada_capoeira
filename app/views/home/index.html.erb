<div class="text-center py-16 bg-white rounded-lg shadow">
  <h1 class="text-4xl font-bold text-gray-900">Abadá Capoeira</h1>
  <p class="mt-3 text-lg text-gray-600">Encontre um núcleo perto de você e acompanhe nossos eventos.</p>

  <div class="mt-8 flex justify-center gap-4">
    <%= link_to "Encontre uma Abada", points_path, class: "bg-brand-700 text-white font-semibold px-6 py-3 rounded-md hover:bg-brand-800" %>
    <%= link_to "Ver eventos", events_path, class: "bg-gray-200 text-gray-800 font-semibold px-6 py-3 rounded-md hover:bg-gray-300" %>
  </div>
</div>

<% if @events.any? %>
  <div class="mt-10">
    <h2 class="text-xl font-bold text-gray-900 mb-4">Próximos eventos</h2>
    <div class="grid gap-4 sm:grid-cols-3">
      <% @events.each do |event| %>
        <%= link_to event_path(event), class: "block bg-white rounded-lg shadow p-4 hover:shadow-md" do %>
          <h3 class="font-semibold text-gray-900"><%= event.title %></h3>
          <% if event.starts_at %>
            <p class="text-sm text-gray-500 mt-1"><%= l event.starts_at, format: :long %></p>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
