<%= render "shared/admin_subnav" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Pontos</h1>
  <%= link_to "Novo ponto", new_admin_point_path, class: "bg-brand-700 text-white font-semibold px-4 py-2 rounded-md hover:bg-brand-800" %>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Cidade</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Professor</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Telefone</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Geocodificação</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @points.each do |point| %>
        <tr>
          <td class="px-4 py-3 text-gray-900"><%= point.city %> - <%= point.state %></td>
          <td class="px-4 py-3 text-gray-700"><%= point.teacher_name %></td>
          <td class="px-4 py-3 text-gray-700"><%= point.phone %></td>
          <td class="px-4 py-3">
            <span class="text-xs px-2 py-1 rounded-full <%= point.geocode_status == 'success' ? 'bg-brand-green-100 text-brand-green-800' : 'bg-yellow-100 text-yellow-800' %>">
              <%= point.geocode_status %>
            </span>
          </td>
          <td class="px-4 py-3 text-right space-x-3">
            <%= link_to "Editar", edit_admin_point_path(point), class: "text-brand-700 hover:underline" %>
            <%= button_to "Remover", admin_point_path(point), method: :delete, class: "text-brand-700 hover:underline bg-transparent border-0 p-0 cursor-pointer", form: { data: { turbo_confirm: "Remover este ponto?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
