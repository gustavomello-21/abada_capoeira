<div class="max-w-md mx-auto mt-12 bg-white p-8 rounded-lg shadow">
  <h2 class="text-2xl font-bold mb-6 text-gray-900">Alterar senha</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
    <%= render "users/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div>
      <%= f.label :password, "Nova senha", class: "block text-sm font-medium text-gray-700" %>
      <% if @minimum_password_length %>
        <p class="text-xs text-gray-500">(mínimo de <%= @minimum_password_length %> caracteres)</p>
      <% end %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirme a nova senha", class: "block text-sm font-medium text-gray-700" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
    </div>

    <div>
      <%= f.submit "Alterar senha", class: "w-full bg-brand-700 text-white font-semibold py-2 px-4 rounded-md hover:bg-brand-800 cursor-pointer" %>
    </div>
  <% end %>

  <div class="mt-4 text-sm text-gray-600">
    <%= render "users/shared/links" %>
  </div>
</div>
