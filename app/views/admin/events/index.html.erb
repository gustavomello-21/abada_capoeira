<%= render "shared/admin_subnav" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Eventos</h1>
  <%= link_to "Novo evento", new_admin_event_path, class: "bg-brand-700 text-white font-semibold px-4 py-2 rounded-md hover:bg-brand-800" %>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Título</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Início</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Inscrições</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @events.each do |event| %>
        <tr>
          <td class="px-4 py-3 text-gray-900"><%= link_to event.title, admin_event_path(event), class: "hover:underline" %></td>
          <td class="px-4 py-3">
            <span class="text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-800"><%= event.status %></span>
          </td>
          <td class="px-4 py-3 text-gray-700"><%= event.starts_at&.strftime("%d/%m/%Y") %></td>
          <td class="px-4 py-3 text-gray-700"><%= event.registrations.count %></td>
          <td class="px-4 py-3 text-right space-x-3">
            <%= link_to "Editar", edit_admin_event_path(event), class: "text-brand-700 hover:underline" %>
            <%= button_to "Remover", admin_event_path(event), method: :delete, class: "text-brand-700 hover:underline bg-transparent border-0 p-0 cursor-pointer", form: { data: { turbo_confirm: "Remover este evento?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
