<%= render "shared/admin_subnav" %>

<div class="mb-6">
  <%= link_to "← #{@event.title}", admin_event_path(@event), class: "text-brand-700 hover:underline text-sm" %>
  <h1 class="text-2xl font-bold text-gray-900 mt-1">Inscrições</h1>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Aluno</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">E-mail</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Enviado em</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @registrations.each do |registration| %>
        <tr>
          <td class="px-4 py-3 text-gray-900"><%= registration.user.name %></td>
          <td class="px-4 py-3 text-gray-700"><%= registration.user.email %></td>
          <td class="px-4 py-3">
            <% status_classes = { "pending" => "bg-yellow-100 text-yellow-800", "approved" => "bg-brand-green-100 text-brand-green-800", "rejected" => "bg-red-100 text-red-800" } %>
            <span class="text-xs px-2 py-1 rounded-full <%= status_classes[registration.status] %>">
              <%= { "pending" => "Pendente", "approved" => "Aprovada", "rejected" => "Rejeitada" }[registration.status] %>
            </span>
          </td>
          <td class="px-4 py-3 text-gray-700"><%= registration.created_at.strftime("%d/%m/%Y %H:%M") %></td>
          <td class="px-4 py-3 text-right">
            <%= link_to "Revisar", admin_event_registration_path(@event, registration), class: "text-brand-700 hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @total_pages > 1 %>
  <div class="mt-4 flex gap-2 text-sm">
    <% (1..@total_pages).each do |page_number| %>
      <%= link_to page_number, admin_event_registrations_path(@event, page: page_number),
            class: "px-3 py-1 rounded-md #{page_number == @page ? 'bg-brand-700 text-white' : 'bg-white text-gray-700 border border-gray-300'}" %>
    <% end %>
  </div>
<% end %>
