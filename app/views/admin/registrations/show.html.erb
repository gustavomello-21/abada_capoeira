<%= render "shared/admin_subnav" %>

<div class="mb-6">
  <%= link_to "← Inscrições de #{@event.title}", admin_event_registrations_path(@event), class: "text-brand-700 hover:underline text-sm" %>
</div>

<div class="grid md:grid-cols-3 gap-6">
  <div class="md:col-span-2 bg-white rounded-lg shadow p-6">
    <h1 class="text-xl font-bold text-gray-900"><%= @registration.user.name %></h1>
    <p class="text-gray-600"><%= @registration.user.email %> · <%= @registration.user.phone %></p>

    <dl class="mt-6 space-y-4">
      <% @event.event_fields.each do |field| %>
        <div>
          <dt class="text-sm font-medium text-gray-500"><%= field.label %></dt>
          <dd class="text-gray-900"><%= @registration.answer_for(field)&.value.presence || "—" %></dd>
        </div>
      <% end %>
    </dl>

    <% if @registration.rejection_reason.present? %>
      <div class="mt-6 bg-red-50 border border-red-200 rounded-md p-4 text-sm text-red-800">
        <p class="font-semibold">Motivo da rejeição</p>
        <p><%= @registration.rejection_reason %></p>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="font-semibold text-gray-900 mb-3">Comprovante PIX</h2>
    <% if @registration.payment_proof.attached? %>
      <% if @registration.payment_proof.image? %>
        <%= image_tag @registration.payment_proof, class: "w-full rounded border border-gray-200" %>
      <% else %>
        <%= link_to "Abrir comprovante", rails_blob_path(@registration.payment_proof, disposition: "inline"), target: "_blank", class: "text-brand-700 hover:underline" %>
      <% end %>
    <% else %>
      <p class="text-sm text-gray-500">Nenhum comprovante anexado.</p>
    <% end %>

    <div class="mt-6 space-y-3">
      <% status_labels = { "pending" => "Pendente", "approved" => "Aprovada", "rejected" => "Rejeitada" } %>
      <p class="text-sm text-gray-600">Status atual: <span class="font-semibold"><%= status_labels[@registration.status] %></span></p>

      <%= button_to "Aprovar inscrição", approve_admin_event_registration_path(@event, @registration), method: :patch,
            class: "w-full bg-brand-green-700 text-white font-semibold py-2 rounded-md hover:bg-brand-green-800 cursor-pointer" %>

      <%= form_with url: reject_admin_event_registration_path(@event, @registration), method: :patch, class: "space-y-2" do |f| %>
        <%= f.text_area :rejection_reason, rows: 2, placeholder: "Motivo da rejeição (opcional)",
              class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-500 focus:ring-brand-500 text-sm" %>
        <%= f.submit "Rejeitar inscrição", class: "w-full bg-white text-red-700 border border-red-700 font-semibold py-2 rounded-md hover:bg-red-50 cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
