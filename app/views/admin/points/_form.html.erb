<%= form_with model: [ :admin, point ], html: { class: "space-y-4 bg-white rounded-lg shadow p-6", data: { controller: "cep" } } do |f| %>
  <% if point.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-800 rounded-md p-4 text-sm">
      <p class="font-semibold mb-1"><%= pluralize(point.errors.count, "erro") %> impediram o salvamento:</p>
      <ul class="list-disc list-inside">
        <% point.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :teacher_name, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :teacher_name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
    </div>
    <div>
      <%= f.label :phone, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :phone, inputmode: "tel", maxlength: 15,
            data: { controller: "masked-input", action: "input->masked-input#format" },
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
    </div>
  </div>

  <div class="grid sm:grid-cols-3 gap-4">
    <div>
      <%= f.label :zip_code, "CEP", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :zip_code, inputmode: "numeric", maxlength: 9, placeholder: "00000-000",
            data: { cep_target: "zip", action: "input->cep#mask" },
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
      <p class="mt-1 text-xs text-gray-500">Digite o CEP para preencher o endereço automaticamente.</p>
    </div>
    <div>
      <%= f.label :number, "Número", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :number, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
    </div>
    <div>
      <%= f.label :complement, "Complemento", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :complement, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
    </div>
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :street, "Rua", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :street, data: { cep_target: "street" },
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
    </div>
    <div>
      <%= f.label :neighborhood, "Bairro", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :neighborhood, data: { cep_target: "neighborhood" },
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
    </div>
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :city, "Cidade", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :city, data: { cep_target: "city" },
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
    </div>
    <div>
      <%= f.label :state, "Estado (UF)", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :state, options_for_select(Point::BRAZILIAN_STATES.map { |name, uf| [ "#{name} (#{uf})", uf ] }, point.state),
            { include_blank: "Selecione..." },
            data: { cep_target: "state" },
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
    </div>
  </div>

  <div>
    <%= f.label :details, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :details, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-500 focus:ring-brand-500" %>
  </div>

  <div>
    <%= f.label :photo, class: "block text-sm font-medium text-gray-700" %>
    <% if point.photo.attached? %>
      <%= image_tag point.photo, class: "mt-2 h-24 w-24 object-cover rounded" %>
    <% end %>
    <%= f.file_field :photo, accept: "image/*", class: "mt-1 block w-full text-sm text-gray-600" %>
  </div>

  <div>
    <%= f.submit "Salvar", class: "bg-brand-700 text-white font-semibold px-5 py-2 rounded-md hover:bg-brand-800 cursor-pointer" %>
  </div>
<% end %>
