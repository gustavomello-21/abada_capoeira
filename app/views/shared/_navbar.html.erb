<nav class="bg-brand-800 text-white shadow">
  <div class="container mx-auto px-4 py-3 flex items-center justify-between">
    <%= link_to root_path, class: "flex items-center" do %>
      <%= image_tag "logo-abada-capoeira.png", alt: "Abadá Capoeira", class: "h-10 w-auto" %>
    <% end %>

    <div class="flex items-center gap-5 text-sm font-medium">
      <%= link_to "Encontre uma Abada", points_path, class: "hover:text-brand-200" %>

      <% if user_signed_in? %>
        <%= link_to "Eventos", events_path, class: "hover:text-brand-200" %>

        <% if current_user.admin? %>
          <%= link_to "Painel Admin", admin_root_path, class: "hover:text-brand-200" %>
        <% end %>

        <%= link_to "Minha conta", edit_user_registration_path, class: "hover:text-brand-200" %>
        <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "hover:text-brand-200 underline bg-transparent border-0 p-0 cursor-pointer" %>
      <% else %>
        <%= link_to "Entrar", new_user_session_path, class: "hover:text-brand-200" %>
        <%= link_to "Cadastrar", new_user_registration_path, class: "bg-white text-brand-800 px-3 py-1.5 rounded-md hover:bg-brand-100" %>
      <% end %>
    </div>
  </div>
</nav>
