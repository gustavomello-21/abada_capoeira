<div class="border border-gray-200 rounded-md p-4 mb-3" data-nested-fields-row data-persisted="<%= f.object.persisted? %>" data-controller="field-type">
  <%= f.hidden_field :id if f.object.persisted? %>
  <%= f.hidden_field :_destroy %>

  <div class="grid sm:grid-cols-3 gap-3">
    <div class="sm:col-span-2">
      <%= f.label :label, class: "block text-xs font-medium text-gray-500" %>
      <%= f.text_field :label, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-500 focus:ring-brand-500", placeholder: "Ex: Corda, Idade, Nome do professor" %>
    </div>

    <div>
      <%= f.label :field_type, "Tipo", class: "block text-xs font-medium text-gray-500" %>
      <%= f.select :field_type,
            EventField.field_types.keys.map { |key| [ EventField.human_field_type(key), key ] },
            {},
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-500 focus:ring-brand-500",
            data: { field_type_target: "select", action: "change->field-type#toggle" } %>
    </div>
  </div>

  <div class="mt-3 flex items-center gap-2">
    <%= f.check_box :required, class: "h-4 w-4 rounded border-gray-300 text-brand-600" %>
    <%= f.label :required, class: "text-sm text-gray-700" %>
  </div>

  <div class="mt-3" data-field-type-target="options">
    <%= f.label :options_text, class: "block text-xs font-medium text-gray-500" %>
    <%= f.text_area :options_text, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-500 focus:ring-brand-500", placeholder: "Corda Crua&#10;Corda Amarela&#10;Corda Laranja" %>
  </div>

  <button type="button" data-action="nested-fields#remove" class="mt-3 text-sm text-brand-700 hover:underline">Remover campo</button>
</div>
